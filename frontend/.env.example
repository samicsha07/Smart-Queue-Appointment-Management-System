# SmartQueue Frontend Environment Variables

# Local Development:
VITE_API_URL=http://localhost:8000/api
VITE_WS_HOST=localhost:8000

# Live Production Deployment (Render + Vercel):
# Replace with your deployed backend Render URL (without http/ws protocol for WS host):
# VITE_API_URL=https://smartqueue-backend.onrender.com/api
# VITE_WS_HOST=smartqueue-backend.onrender.com
